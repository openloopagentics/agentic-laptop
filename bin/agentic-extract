#!/usr/bin/env python3
"""Emit compact records from agent transcripts on THIS machine.

Runs locally or over ssh on a remote host; the corpus is over a gigabyte, so
this reduces it at the source and streams only what is indexable:

  {"k":"m", ...}  one message: project, session, time, role, text
  {"k":"c", ...}  one session's cost, from Claude's own cost-state record

Tool results and thinking blocks are skipped -- they dominate the bytes and
are rarely what you are searching for.
"""
import json
import os
import sys
from pathlib import Path

MAX_TEXT = 4000
HOST = os.environ.get("AGENTIC_HOST", "local")


def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = [b.get("text", "") for b in content
                 if isinstance(b, dict) and b.get("type") == "text"]
        return "\n".join(p for p in parts if p)
    return ""


def project_of(rec):
    cwd = rec.get("cwd") or ""
    return Path(cwd).name or cwd or "unknown"


def emit(obj):
    sys.stdout.write(json.dumps(obj, separators=(",", ":")) + "\n")


def main():
    roots = [Path.home() / ".claude/projects"]
    for root in roots:
        if not root.exists():
            continue
        for path in root.rglob("*.jsonl"):
            project = session = None
            try:
                with path.open(errors="replace") as fh:
                    for line in fh:
                        if '"type"' not in line:
                            continue
                        try:
                            rec = json.loads(line)
                        except ValueError:
                            continue
                        t = rec.get("type")
                        if t in ("user", "assistant"):
                            project = project or project_of(rec)
                            session = session or rec.get("sessionId")
                            msg = rec.get("message") or {}
                            body = text_of(msg.get("content"))
                            if not body.strip():
                                continue
                            emit({"k": "m", "h": HOST, "p": project,
                                  "s": rec.get("sessionId"), "t": rec.get("timestamp"),
                                  "r": msg.get("role", t), "x": body[:MAX_TEXT],
                                  "f": path.name})
                        elif t == "cost-state":
                            emit({"k": "c", "h": HOST, "p": project or "unknown",
                                  "s": rec.get("sessionId"),
                                  "usd": rec.get("totalCostUSD") or 0,
                                  "start": rec.get("startTime") or 0,
                                  "models": list((rec.get("modelUsage") or {}).keys())})
            except OSError:
                continue


if __name__ == "__main__":
    main()
