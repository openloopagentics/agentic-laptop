#!/usr/bin/env python3
"""Answer an agent's prompt from the phone.

ntfy notifications carry action buttons pointing at this endpoint. It types a
fixed keystroke into the tmux session that raised the badge, and nothing else.

Deliberately narrow:
  * binds to the tailnet address only, never 0.0.0.0
  * requires a token that lives in a 0600 config file
  * accepts two named actions mapping to fixed keys; no arbitrary input
  * only targets a session that currently has a pending badge
"""
import hmac
import re
import threading
import time
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse

CONF = Path.home() / ".config/claude-badged/push.conf"
BADGES = Path("/var/lib/claude-limits/badges.toml")

# The only keystrokes this service will ever send.
ACTIONS = {
    "approve": ["1", "Enter"],
    "deny": ["Escape"],
}
SAFE_NAME = re.compile(r"^[A-Za-z0-9._-]{1,64}$")

# ntfy retries an action's HTTP call, and a phone is easy to double-tap. A
# repeat of the same action on the same session inside this window is dropped:
# a duplicate keystroke would fall through a prompt to whatever came next.
DEDUP_SECONDS = 8
_recent = {}
_recent_lock = threading.Lock()


def duplicate(host, session, action):
    key = (host, session, action)
    now = time.monotonic()
    with _recent_lock:
        last = _recent.get(key, 0)
        if now - last < DEDUP_SECONDS:
            return True
        _recent[key] = now
        # keep the table from growing without bound
        for k, ts in list(_recent.items()):
            if now - ts > DEDUP_SECONDS * 10:
                del _recent[k]
    return False


def config():
    cfg = {}
    for line in CONF.read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if "=" in line:
            k, _, v = line.partition("=")
            cfg[k.strip()] = v.strip()
    return cfg


def pending_workspaces():
    try:
        return {l.partition("=")[0].strip()
                for l in BADGES.read_text().splitlines() if "=" in l}
    except FileNotFoundError:
        return set()


def workspace_of(name):
    return re.sub(r"\d+$", "", name.split(".", 1)[0]) or name


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):  # to the journal, not stderr noise
        sys.stderr.write("claude-actiond: " + fmt % args + "\n")

    def reply(self, code, body):
        self.send_response(code)
        self.send_header("Content-Type", "text/plain")
        self.end_headers()
        self.wfile.write(body.encode())

    def do_POST(self):
        self.do_GET()

    def do_GET(self):
        q = parse_qs(urlparse(self.path).query)
        got = q.get("t", [""])[0]
        want = self.server.cfg.get("action_token", "")
        if not want or not hmac.compare_digest(got, want):
            return self.reply(403, "no")

        host = q.get("h", [""])[0]
        session = q.get("s", [""])[0]
        action = q.get("a", [""])[0]

        if action not in ACTIONS:
            return self.reply(400, "unknown action")
        if not (SAFE_NAME.match(host) and SAFE_NAME.match(session)):
            return self.reply(400, "bad target")
        if workspace_of(session) not in pending_workspaces():
            return self.reply(409, "nothing pending there")
        if duplicate(host, session, action):
            self.log_message("ignored duplicate %s -> %s:%s", action, host, session)
            return self.reply(200, "already sent")

        keys = ACTIONS[action]
        cmd = ["tmux", "send-keys", "-t", session, *keys]
        if host != "local":
            cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", host,
                   " ".join(["tmux", "send-keys", "-t", session, *keys])]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
        if r.returncode != 0:
            self.log_message("send-keys failed: %s", r.stderr.strip()[:120])
            return self.reply(502, "could not reach that session")
        self.log_message("%s -> %s:%s", action, host, session)
        self.reply(200, f"{action} sent to {session}")


def main():
    cfg = config()
    bind = cfg.get("action_bind", "127.0.0.1")
    port = int(cfg.get("action_port", "8787"))
    srv = HTTPServer((bind, port), Handler)
    srv.cfg = cfg
    print(f"claude-actiond listening on {bind}:{port}", file=sys.stderr)
    srv.serve_forever()


if __name__ == "__main__":
    main()
