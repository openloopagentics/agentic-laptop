#!/usr/bin/env python3
"""Which project is actually spending the budget.

`climits` reports utilisation per account; this attributes spend per project,
from the cost records Claude Code writes into each transcript.

    agentic-costs              # by project
    agentic-costs --days 7     # only the last week
    agentic-costs --by host
"""
import argparse
import sqlite3
import time
from pathlib import Path

DB = Path.home() / ".cache/agentic/index.db"


def bar(frac, width=24):
    filled = int(round(frac * width))
    return "█" * filled + "·" * (width - filled)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--days", type=float, help="only sessions started in this window")
    ap.add_argument("--by", default="project", choices=("project", "host", "model"))
    ap.add_argument("-n", type=int, default=15)
    args = ap.parse_args()

    if not DB.exists():
        raise SystemExit("no index yet -- run: agentic-index")

    where, params = "", []
    if args.days:
        where = "WHERE start > ?"
        params.append(int((time.time() - args.days * 86400) * 1000))

    col = {"project": "project", "host": "host", "model": "models"}[args.by]
    db = sqlite3.connect(DB)
    rows = db.execute(
        f"SELECT {col}, SUM(usd), COUNT(*) FROM costs {where} "
        f"GROUP BY {col} ORDER BY SUM(usd) DESC", params).fetchall()
    rows = [r for r in rows if r[1]]
    if not rows:
        raise SystemExit("no cost records in that window")

    total = sum(r[1] for r in rows)
    span = f" (last {args.days:g}d)" if args.days else ""
    print(f"\n  spend by {args.by}{span} — ${total:,.2f} across "
          f"{sum(r[2] for r in rows)} sessions\n")
    for name, usd, n in rows[:args.n]:
        share = usd / total
        print(f"  {(name or 'unknown')[:22]:22} {bar(share)} ${usd:7,.2f}  {share*100:4.1f}%  {n:3d} sess")
    print()


if __name__ == "__main__":
    main()
