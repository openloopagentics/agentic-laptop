[Unit]
Description=Check the agentic laptop setup is actually working

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/agentic-doctor --quiet --push
# a failing check is the point, not a unit failure
SuccessExitStatus=0 1 2 3 4 5 6 7 8
TimeoutStartSec=120
