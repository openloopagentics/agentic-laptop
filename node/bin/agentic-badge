#!/usr/bin/env bash
# Record an agent attention event, and notify directly.
#
# Runs on the node where the agent actually lives, so notifications do not
# depend on any controller being awake. The log is still written, because a
# controller that IS awake uses it to draw badges.
#
# usage: agentic-badge ask|done
set -uo pipefail
state=${1:?usage: agentic-badge ask|busy|done|stop}
conf="$HOME/.agentic/config"

# `stop` resolves itself from the hook payload on stdin. Claude Code fires
# Stop when the main loop ends, but background shells, subagents and monitors
# carry on -- and the payload lists them. Reporting `done` then is a lie the
# strip has been telling: the workspace looks finished while work continues.
if [ "$state" = stop ]; then
    state=$(python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("done"); raise SystemExit          # unreadable payload: old behaviour
tasks = d.get("background_tasks") or []
live = [t for t in tasks if str(t.get("status", "")).lower() not in ("completed", "failed", "cancelled")]
print("busy" if live else "done")
' 2>/dev/null) || state=done
    [ -n "$state" ] || state=done
fi

session=$(tmux display-message -p "#S" 2>/dev/null) || exit 0
[ -n "$session" ] || exit 0

# busy fires on every tool call; only log it when the state changes or once a
# minute, which is enough to keep the controller's spinner from expiring.
last="$HOME/.cache/agentic-badge/$session"
if [ "$state" = busy ] && [ -n "$(find "$last" -mmin -1 2>/dev/null)" ] \
    && [ "$(cat "$last" 2>/dev/null)" = busy ]; then
    exit 0
fi
mkdir -p "${last%/*}" && printf '%s\n' "$state" > "$last"

printf '%s %s\n' "$session" "$state" >> "$HOME/.claude-badges.log"

# Only a pending question is worth a phone notification; "busy" and "done"
# are for badges on the strip.
[ "$state" = "ask" ] || exit 0
[ -f "$conf" ] || exit 0
# shellcheck disable=SC1090
. "$conf"
[ -n "${NTFY_TOPIC:-}" ] || exit 0

node=${NODE_NAME:-$(hostname -s)}
actions=""
if [ -n "${ACTION_TOKEN:-}" ] && [ -n "${ACTION_BIND:-}" ]; then
    base="http://${ACTION_BIND}:${ACTION_PORT:-8787}/act?t=${ACTION_TOKEN}&s=${session}"
    actions="http, Approve, ${base}&a=approve, method=POST, clear=true; http, Deny, ${base}&a=deny, method=POST, clear=true"
fi

curl -fsS -m 10 \
    -H "Title: ${session} on ${node}" \
    -H "Tags: bell" \
    ${actions:+-H "Actions: $actions"} \
    -d "An agent is waiting for input." \
    "$NTFY_TOPIC" >/dev/null 2>&1 || true
