+impl Widget {
+    /// Three concentric arcs, outermost first, in the Apple-fitness idiom:
+    /// a full-circle track under each, a rounded cap, and the most-consumed
+    /// ring's value called out beside them so the button reads at a glance.
+    /// Three stacked bars, outermost limit first. At 42px of button height a
+    /// concentric ring is only ~4px of stroke; a bar gets the full width and
+    /// reads from across a desk.
+    fn render_bars(&self, c: &Context, left_edge: f64, width: f64, bot: f64, top: f64) {
+        let h = top - bot;
+        let pad_x = 7.0;
+        let bar_h = (h / 5.0).max(4.0);
+        let gap = (h - bar_h * 3.0) / 4.0;
+
+        // Reserve room for the callout only if the button is wide enough.
+        let worst = self.rings.iter().cloned().fold(0.0f64, f64::max);
+        let label = format!("{}%", worst.round() as i64);
+        c.set_font_size(h * 0.40);
+        let text_w = c.text_extents(&label).unwrap().width();
+        let show_text = width > text_w + 60.0;
+        let track_w = width - pad_x * 2.0 - if show_text { text_w + 8.0 } else { 0.0 };
+
+        for (i, pct) in self.rings.iter().enumerate() {
+            let col = RING_COLORS[i];
+            let y = bot + gap + i as f64 * (bar_h + gap);
+            let r = bar_h / 2.0;
+
+            rounded_bar(c, left_edge + pad_x, y, track_w, bar_h, r);
+            c.set_source_rgba(col.r, col.g, col.b, 0.22);
+            c.fill().unwrap();
+
+            let filled = (pct / 100.0).clamp(0.0, 1.0) * track_w;
+            if filled > 0.5 {
+                rounded_bar(c, left_edge + pad_x, y, filled.max(bar_h), bar_h, r);
+                c.set_source_rgb(col.r, col.g, col.b);
+                c.fill().unwrap();
+            }
+        }
+
+        if show_text {
+            let idx = self
+                .rings
+                .iter()
+                .enumerate()
+                .fold((0usize, -1.0f64), |a, (i, v)| if *v > a.1 { (i, *v) } else { a })
+                .0;
+            let col = RING_COLORS[idx];
+            c.set_source_rgb(col.r, col.g, col.b);
+            let ext = c.text_extents(&label).unwrap();
+            c.move_to(left_edge + width - pad_x - text_w, bot + h / 2.0 + ext.height() / 2.0);
+            c.show_text(&label).unwrap();
+        }
+    }
+
+    fn render_rings(&self, c: &Context, left_edge: f64, width: f64, bot: f64, top: f64) {
+        let h = top - bot;
+        let stroke = (h / 9.0).max(3.0);
+        let gap = stroke * 0.45;
+        let cy = bot + h / 2.0;
+        let cx = left_edge + h / 2.0 + 4.0;
+        let outer = h / 2.0 - stroke / 2.0 - 1.0;
+
+        for (i, pct) in self.rings.iter().enumerate() {
+            let r = outer - i as f64 * (stroke + gap);
+            if r <= stroke * 0.6 {
+                continue;
+            }
+            let col = RING_COLORS[i];
+            c.set_line_width(stroke);
+            c.set_line_cap(cairo::LineCap::Round);
+
+            c.set_source_rgba(col.r, col.g, col.b, 0.22);
+            c.arc(cx, cy, r, 0.0, std::f64::consts::TAU);
+            c.stroke().unwrap();
+
+            if *pct > 0.0 {
+                let sweep = (pct / 100.0).min(1.0) * std::f64::consts::TAU;
+                c.set_source_rgb(col.r, col.g, col.b);
+                let start = -std::f64::consts::FRAC_PI_2;
+                c.arc(cx, cy, r, start, start + sweep);
+                c.stroke().unwrap();
+            }
+        }
+
+        // Call out whichever limit is closest to its ceiling.
+        let (idx, worst) = self
+            .rings
+            .iter()
+            .enumerate()
+            .fold((0usize, 0.0f64), |acc, (i, v)| if *v > acc.1 { (i, *v) } else { acc });
+        let text = format!("{}%", worst.round() as i64);
+        let text_x = cx + h / 2.0 + 6.0;
+        if text_x < left_edge + width - 6.0 {
+            let col = RING_COLORS[idx];
+            c.set_source_rgb(col.r, col.g, col.b);
+            c.set_font_size(h * 0.42);
+            let ext = c.text_extents(&text).unwrap();
+            c.move_to(text_x, cy + ext.height() / 2.0);
+            c.show_text(&text).unwrap();
+        }
+    }
+}
