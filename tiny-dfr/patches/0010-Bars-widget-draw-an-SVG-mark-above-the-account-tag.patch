+++ b/src/widget.rs
@@ -2,8 +2,10 @@
 //! the button rectangle rather than as a centred glyph.
 
 use cairo::Context;
+use librsvg_rebind::{prelude::HandleExt, Handle, Rectangle};
 use std::collections::VecDeque;
 use std::fs::read_to_string;
+use std::path::PathBuf;
 
 use crate::config::Rgb;
 use serde::Deserialize;
@@ -118,6 +120,24 @@ pub struct Widget {
     account: Option<String>,
     /// Short tag drawn at the left of a bars widget, to tell accounts apart.
     label: Option<String>,
+    /// Optional mark drawn above that tag, resolved like any other icon.
+    logo: Option<Handle>,
+}
+
+/// Icons live beside the daemon's own, so a user drops an SVG in /etc and
+/// names it from the config.
+fn load_logo(name: &str) -> Option<Handle> {
+    for dir in ["/etc/tiny-dfr", "/usr/share/tiny-dfr"] {
+        let path = PathBuf::from(format!("{dir}/{name}.svg"));
+        if path.exists() {
+            match Handle::from_file(&path.to_string_lossy()) {
+                Ok(h) => return Some(h),
+                Err(_) => eprintln!("tiny-dfr: could not parse {}", path.display()),
+            }
+        }
+    }
+    eprintln!("tiny-dfr: no logo named {name:?} in /etc/tiny-dfr or /usr/share/tiny-dfr");
+    None
 }
 
 impl Widget {
@@ -129,6 +149,7 @@ impl Widget {
         path: Option<String>,
         account: Option<String>,
         label: Option<String>,
+        logo: Option<String>,
     ) -> Widget {
         let capacity = capacity.max(2);
         Widget {
@@ -143,6 +164,7 @@ impl Widget {
             path,
             account,
             label,
+            logo: logo.as_deref().and_then(load_logo),
         }
     }
 
@@ -318,8 +340,34 @@ impl Widget {
         // above the other read better than three in a 42px-tall button.
         let mut bars_x = left_edge + pad_x;
         if let Some(label) = &self.label {
-            let lines: Vec<&str> = label.split('-').filter(|s| !s.is_empty()).collect();
+            let mut lines: Vec<&str> = label.split('-').filter(|s| !s.is_empty()).collect();
             c.set_source_rgb(color.r, color.g, color.b);
+
+            // A logo replaces the first half of the tag: the provider is shown
+            // as a mark, the account stays a letter beneath it.
+            if let Some(logo) = &self.logo {
+                let size = h * 0.44;
+                let letter = lines.last().copied().unwrap_or("");
+                c.set_font_size(h * 0.38);
+                let ext = c.text_extents(letter).unwrap();
+                let col_w = size.max(ext.width());
+                let gap = h * 0.06;
+                let total = size + gap + ext.height();
+                let top = bot + (h - total) / 2.0;
+
+                let _ = logo.render_document(
+                    c,
+                    &Rectangle::new(bars_x + (col_w - size) / 2.0, top, size, size),
+                );
+                c.set_source_rgb(color.r, color.g, color.b);
+                c.move_to(bars_x + (col_w - ext.width()) / 2.0 - ext.x_bearing(),
+                          top + size + gap + ext.height());
+                c.show_text(letter).unwrap();
+
+                bars_x += col_w + 7.0;
+                lines.clear();
+            }
+
             if lines.len() > 1 {
                 let size = h * 0.40;
                 c.set_font_size(size);
@@ -337,7 +385,7 @@ impl Widget {
                     c.show_text(line).unwrap();
                 }
                 bars_x += widest + 7.0;
-            } else {
+            } else if lines.len() == 1 {
                 c.set_font_size(h * 0.34);
                 let ext = c.text_extents(label).unwrap();
                 c.move_to(bars_x, bot + h / 2.0 + ext.height() / 2.0);
