+use std::{collections::HashMap, fmt, fs::read_to_string, os::fd::AsFd};
 
 const USER_CFG_PATH: &str = "/etc/tiny-dfr/config.toml";
 
+/// A resolved colour. Stored as cairo's 0.0-1.0 components so the draw path
+/// can hand it straight to set_source_rgb.
+#[derive(Copy, Clone, Debug, PartialEq)]
+pub struct Rgb {
+    pub r: f64,
+    pub g: f64,
+    pub b: f64,
+}
+
+impl Rgb {
+    pub fn from_hex(s: &str) -> Option<Rgb> {
+        let s = s.strip_prefix('#').unwrap_or(s);
+        if s.len() != 6 {
+            return None;
+        }
+        let v = u32::from_str_radix(s, 16).ok()?;
+        Some(Rgb {
+            r: ((v >> 16) & 0xff) as f64 / 255.0,
+            g: ((v >> 8) & 0xff) as f64 / 255.0,
+            b: (v & 0xff) as f64 / 255.0,
+        })
+    }
+}
+
+/// Per-button colour overrides. All optional: None everywhere reproduces the
+/// stock greyscale appearance exactly.
+#[derive(Copy, Clone, Debug, Default)]
+pub struct ButtonColors {
+    pub fg: Option<Rgb>,
+    pub bg: Option<Rgb>,
+    pub active_bg: Option<Rgb>,
+}
+
+/// Resolve a config string that is either a palette name or a #rrggbb literal.
+/// A bad value is reported and ignored rather than fatal, so a typo during a
+/// live config reload cannot take the daemon down.
+fn resolve_color(value: &Option<String>, palette: &HashMap<String, Rgb>) -> Option<Rgb> {
+    let name = value.as_ref()?;
+    if let Some(rgb) = palette.get(name) {
+        return Some(*rgb);
+    }
+    match Rgb::from_hex(name) {
+        Some(rgb) => Some(rgb),
+        None => {
+            eprintln!("tiny-dfr: unknown colour {name:?} (not a palette name or #rrggbb)");
+            None
+        }
+    }
+}
+
