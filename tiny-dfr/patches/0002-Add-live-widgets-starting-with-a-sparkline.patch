+//! Live value widgets: a data source sampled on the daemon's tick, drawn into
+//! the button rectangle rather than as a centred glyph.
+
+use cairo::Context;
+use std::collections::VecDeque;
+use std::fs::read_to_string;
+
+use crate::config::Rgb;
+
+pub const DEFAULT_HISTORY: usize = 32;
+
+#[derive(Copy, Clone, Debug, PartialEq)]
+pub enum WidgetKind {
+    Sparkline,
+}
+
+impl WidgetKind {
+    pub fn parse(s: &str) -> Option<WidgetKind> {
+        match s {
+            "sparkline" => Some(WidgetKind::Sparkline),
+            _ => None,
+        }
+    }
+}
+
+#[derive(Copy, Clone, Debug, PartialEq)]
+pub enum SourceKind {
+    Cpu,
+    Memory,
+}
+
+impl SourceKind {
+    pub fn parse(s: &str) -> Option<SourceKind> {
+        match s {
+            "cpu" => Some(SourceKind::Cpu),
+            "mem" | "memory" => Some(SourceKind::Memory),
+            _ => None,
+        }
+    }
+}
+
+/// Total and idle jiffies from the previous CPU sample. CPU use is only
+/// meaningful as a delta, so the first sample yields nothing.
+#[derive(Default)]
+struct CpuState {
+    total: u64,
+    idle: u64,
+}
+
+pub struct Widget {
+    pub kind: WidgetKind,
+    source: SourceKind,
+    samples: VecDeque<f64>,
+    capacity: usize,
+    fill: bool,
+    cpu: CpuState,
+}
+
+impl Widget {
+    pub fn new(kind: WidgetKind, source: SourceKind, capacity: usize, fill: bool) -> Widget {
+        let capacity = capacity.max(2);
+        Widget {
+            kind,
+            source,
+            samples: VecDeque::with_capacity(capacity),
+            capacity,
+            fill,
+            cpu: CpuState::default(),
+        }
+    }
+
+    /// Take one reading. Returns true if the drawn output would change.
+    pub fn sample(&mut self) -> bool {
+        let value = match self.source {
+            SourceKind::Cpu => self.sample_cpu(),
+            SourceKind::Memory => sample_memory(),
+        };
+        let Some(value) = value else { return false };
+        if self.samples.len() == self.capacity {
+            self.samples.pop_front();
+        }
+        self.samples.push_back(value.clamp(0.0, 1.0));
+        true
+    }
+
+    fn sample_cpu(&mut self) -> Option<f64> {
+        let stat = read_to_string("/proc/stat").ok()?;
+        let line = stat.lines().next()?;
+        let fields: Vec<u64> = line
+            .split_whitespace()
+            .skip(1)
+            .filter_map(|f| f.parse().ok())
+            .collect();
+        if fields.len() < 5 {
+            return None;
+        }
+        let total: u64 = fields.iter().sum();
+        let idle = fields[3] + fields[4]; // idle + iowait
+
+        let prev = std::mem::replace(
+            &mut self.cpu,
+            CpuState {
+                total,
+                idle,
+            },
+        );
+        if prev.total == 0 || total <= prev.total {
+            return None; // first sample, or the counter went backwards
+        }
+        let d_total = (total - prev.total) as f64;
+        let d_idle = (idle.saturating_sub(prev.idle)) as f64;
+        Some(1.0 - (d_idle / d_total))
+    }
+
+    /// Draw into the button rectangle. `bot` and `top` are the same vertical
+    /// bounds the button background uses, so the plot sits inside the pill.
+    pub fn render(
+        &self,
+        c: &Context,
+        left_edge: f64,
+        width: f64,
+        bot: f64,
+        top: f64,
+        color: Rgb,
+    ) {
+        match self.kind {
+            WidgetKind::Sparkline => self.render_sparkline(c, left_edge, width, bot, top, color),
+        }
+    }
+
+    fn render_sparkline(
+        &self,
+        c: &Context,
+        left_edge: f64,
+        width: f64,
+        bot: f64,
+        top: f64,
+        color: Rgb,
+    ) {
+        if self.samples.len() < 2 {
+            return;
+        }
+        let pad_x = 8.0;
+        let pad_y = 6.0;
+        let x0 = left_edge + pad_x;
+        let plot_w = (width - pad_x * 2.0).max(1.0);
+        let y0 = bot + pad_y;
+        let plot_h = (top - bot - pad_y * 2.0).max(1.0);
+
+        let n = self.samples.len();
+        let step = plot_w / (n - 1) as f64;
+        let point = |i: usize, v: f64| (x0 + i as f64 * step, y0 + (1.0 - v) * plot_h);
+
+        if self.fill {
+            let (fx, fy) = point(0, self.samples[0]);
+            c.move_to(fx, y0 + plot_h);
+            c.line_to(fx, fy);
+            for (i, v) in self.samples.iter().enumerate().skip(1) {
+                let (x, y) = point(i, *v);
+                c.line_to(x, y);
+            }
+            c.line_to(x0 + (n - 1) as f64 * step, y0 + plot_h);
+            c.close_path();
+            c.set_source_rgba(color.r, color.g, color.b, 0.30);
+            c.fill().unwrap();
+        }
+
+        c.set_source_rgb(color.r, color.g, color.b);
+        c.set_line_width(1.8);
+        c.set_line_join(cairo::LineJoin::Round);
+        for (i, v) in self.samples.iter().enumerate() {
+            let (x, y) = point(i, *v);
+            if i == 0 {
+                c.move_to(x, y);
+            } else {
+                c.line_to(x, y);
+            }
+        }
+        c.stroke().unwrap();
+
+        // emphasise the most recent reading
+        let (x, y) = point(n - 1, self.samples[n - 1]);
+        c.arc(x, y, 2.2, 0.0, std::f64::consts::TAU);
+        c.fill().unwrap();
+    }
+}
+
+fn sample_memory() -> Option<f64> {
+    let info = read_to_string("/proc/meminfo").ok()?;
+    let mut total = 0u64;
+    let mut available = 0u64;
+    for line in info.lines() {
+        let mut it = line.split_whitespace();
+        match it.next() {
+            Some("MemTotal:") => total = it.next()?.parse().ok()?,
+            Some("MemAvailable:") => available = it.next()?.parse().ok()?,
+            _ => continue,
+        }
+    }
+    if total == 0 {
+        return None;
+    }
+    Some(1.0 - (available as f64 / total as f64))
+}
