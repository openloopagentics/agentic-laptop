From f6954825ad602db6912c561c0130d01c5123f816 Mon Sep 17 00:00:00 2001
From: Ravikant Cherukuri <ravi@openloopagentics.com>
Date: Sun, 13 Sep 2026 23:37:50 -0700
Subject: [PATCH] Draw a bars widget empty when its account stops reporting

A missing account left the widget holding its last figures, so two buttons
showed the same numbers and neither admitted why. Zero the bars and mark them
stale instead: an account that has gone quiet should look quiet.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UmcdUC47KEJPE7hWccLyV6
---
 src/widget.rs | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/widget.rs b/src/widget.rs
index 7a5b856..257d5bb 100644
--- a/src/widget.rs
+++ b/src/widget.rs
@@ -220,7 +220,13 @@ impl Widget {
             .iter()
             .find(|a| wanted.is_none_or(|w| a.email == w))
         else {
-            return false;
+            // The account stopped reporting -- signed out, or its cache gone.
+            // Holding the last figures makes two buttons look alike and lie;
+            // draw it empty and stale instead.
+            let changed = self.rings != [0.0; 3] || !self.stale;
+            self.rings = [0.0; 3];
+            self.stale = true;
+            return changed;
         };
         let next = [
             acct.session.clamp(0.0, 100.0),
-- 
2.55.0

