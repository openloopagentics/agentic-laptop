+            // A counted pill in the top-right corner, in the iOS idiom: it
+            // grows sideways for two or more digits rather than shrinking the
+            // text. `bot` is the button's top edge (cairo y grows downward).
+            if let Some(badge) = &button.badge {
+                if badge.count > 0 {
+                    let (r, g, b) = match badge.state.as_str() {
+                        "ask" => (0.953, 0.545, 0.659),  // #f38ba8 - wants you
+                        "done" => (0.651, 0.890, 0.631), // #a6e3a1 - finished
+                        _ => (0.804, 0.839, 0.957),
+                    };
+                    let label = if badge.count > 99 {
+                        "99+".to_string()
+                    } else {
+                        badge.count.to_string()
+                    };
+
+                    let h = top - bot;
+                    let rad = h * 0.21;
+                    c.set_font_size(rad * 1.35);
+                    let ext = c.text_extents(&label).unwrap();
+                    let pill_w = (ext.width() + rad * 1.1).max(rad * 2.0);
+                    let cy = bot + pixel_shift_y + rad + 1.0;
+                    let right = left_edge + button_width - 3.0;
+                    let left = right - pill_w;
+
+                    c.set_source_rgb(r, g, b);
+                    c.new_sub_path();
+                    c.arc(right - rad, cy, rad, -std::f64::consts::FRAC_PI_2, std::f64::consts::FRAC_PI_2);
+                    c.arc(left + rad, cy, rad, std::f64::consts::FRAC_PI_2, 1.5 * std::f64::consts::PI);
+                    c.close_path();
+                    c.fill().unwrap();
+
+                    // dark numeral: both badge colours are light
+                    c.set_source_rgb(0.12, 0.12, 0.18);
+                    c.move_to(
+                        (left + right) / 2.0 - ext.width() / 2.0 - ext.x_bearing(),
+                        cy + ext.height() / 2.0,
+                    );
+                    c.show_text(&label).unwrap();
+                }
             }
 
             button.changed = false;
