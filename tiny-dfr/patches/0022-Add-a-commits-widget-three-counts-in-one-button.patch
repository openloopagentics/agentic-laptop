+    /// Three whole numbers across the button -- today, this week, this month --
+    /// each under a one-letter tag. Counts, not proportions, so there are no
+    /// bars: the figure itself is the thing worth reading from arm's length.
+    fn render_commits(
+        &self,
+        c: &Context,
+        left_edge: f64,
+        width: f64,
+        bot: f64,
+        top: f64,
+        color: Rgb,
+    ) {
+        let h = top - bot;
+        let col = width / 3.0;
+        // Recency carries the emphasis: today is full strength, the longer
+        // windows sit back, so the eye lands on the figure that changes.
+        const WEIGHT: [f64; 3] = [1.0, 0.72, 0.5];
+        const TAGS: [&str; 3] = ["d", "w", "m"];
+        // Dim the lot when the figures have stopped being refreshed.
+        let fade = if self.stale { 0.4 } else { 1.0 };
+
+        let num_size = h * 0.46;
+        let tag_size = h * 0.24;
+        // Numerals and tag share a baseline block centred in the button: the
+        // count sits above, its tag tucked directly beneath.
+        let num_y = bot + h * 0.52;
+        let tag_y = bot + h * 0.86;
+
+        for i in 0..3 {
+            let centre = left_edge + col * (i as f64 + 0.5);
+            let label = self.counts[i].to_string();
+
+            c.set_font_size(num_size);
+            let ext = c.text_extents(&label).unwrap();
+            c.set_source_rgba(color.r, color.g, color.b, WEIGHT[i] * fade);
+            c.new_path();
+            c.move_to(centre - ext.width() / 2.0 - ext.x_bearing(), num_y);
+            c.show_text(&label).unwrap();
+
+            c.set_font_size(tag_size);
+            let text = TAGS[i];
+            let tag = c.text_extents(text).unwrap();
+            c.set_source_rgba(color.r, color.g, color.b, WEIGHT[i] * fade * 0.55);
+            c.new_path();
+            c.move_to(centre - tag.width() / 2.0 - tag.x_bearing(), tag_y);
+            c.show_text(text).unwrap();
+        }
+    }
+
     fn render_rings(&self, c: &Context, left_edge: f64, width: f64, bot: f64, top: f64) {
         let h = top - bot;
         let stroke = (h / 9.0).max(3.0);
