@@ -213,6 +237,26 @@ impl Widget {
         true
     }
 
+    fn sample_commits(&mut self) -> bool {
+        let Some(path) = &self.path else { return false };
+        let Ok(text) = read_to_string(path) else { return false };
+        let Ok(parsed) = toml::from_str::<CommitsFile>(&text) else { return false };
+        let next = [parsed.today, parsed.week, parsed.month];
+        // The timer runs far more often than this; anything older has stopped
+        // being written, and a counter that cannot say it is stale lies.
+        let age = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map(|d| d.as_secs().saturating_sub(parsed.updated))
+            .unwrap_or(0);
+        let stale = parsed.updated == 0 || age > 45 * 60;
+        if next == self.counts && stale == self.stale {
+            return false;
+        }
+        self.counts = next;
+        self.stale = stale;
+        true
+    }
+
     fn sample_cpu(&mut self) -> Option<f64> {
         let stat = read_to_string("/proc/stat").ok()?;
         let line = stat.lines().next()?;
@@ -261,6 +305,7 @@ impl Widget {
