+/// Where a commits widget gets its three figures: whole counts rather than
+/// percentages, written by `gitcommits` on a timer.
+#[derive(Deserialize)]
+struct CommitsFile {
+    #[serde(default)]
+    today: u64,
+    #[serde(default)]
+    week: u64,
+    #[serde(default)]
+    month: u64,
+    /// Unix time of the write, so a stale count can say so.
+    #[serde(default)]
+    updated: u64,
+}
