From 0511a9598806870d2d87f4a210dc7de76474a405 Mon Sep 17 00:00:00 2001
From: Ravikant Cherukuri <ravi@openloopagentics.com>
Date: Mon, 14 Sep 2026 22:03:46 -0700
Subject: [PATCH] Let a commits widget show spend: Text prefixes and compacts
 its figures

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/widget.rs | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/widget.rs b/src/widget.rs
index 257d5bb..e961c6e 100644
--- a/src/widget.rs
+++ b/src/widget.rs
@@ -521,9 +521,22 @@ impl Widget {
         let num_y = bot + h * 0.52;
         let tag_y = bot + h * 0.86;
 
+        // A `Text` on a commits widget prefixes each figure -- "$" turns the
+        // same three columns into spend -- and compacts four digits and up so
+        // a month's total still fits its third of the button.
+        let prefix = self.label.as_deref().unwrap_or("");
         for i in 0..3 {
             let centre = left_edge + col * (i as f64 + 0.5);
-            let label = self.counts[i].to_string();
+            let n = self.counts[i];
+            let label = if prefix.is_empty() {
+                n.to_string()
+            } else if n >= 10_000 {
+                format!("{prefix}{}k", n / 1000)
+            } else if n >= 1000 {
+                format!("{prefix}{:.1}k", n as f64 / 1000.0)
+            } else {
+                format!("{prefix}{n}")
+            };
 
             c.set_font_size(num_size);
             let ext = c.text_extents(&label).unwrap();
-- 
